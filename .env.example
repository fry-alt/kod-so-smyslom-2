# Скопируйте в .env (make setup делает это сам) и заполните нужное.
# Без единого ключа всё работает на LLM_PROVIDER=fake.
# Комментарии — только на отдельных строках (файл читает и make, и docker compose).

# ===================== LLM =====================
# fake | openai_compatible | yandex | gigachat | anthropic
LLM_PROVIDER=fake
# таймаут одного запроса, сек; число повторов при сетевых ошибках/429/5xx
LLM_TIMEOUT=60
LLM_MAX_RETRIES=2
LLM_TEMPERATURE=0.3
LLM_MAX_TOKENS=2000

# --- openai_compatible: OpenAI, OpenRouter, vLLM, Ollama (http://localhost:11434/v1) и т.п. ---
LLM_BASE_URL=https://api.openai.com/v1
LLM_API_KEY=
LLM_MODEL=gpt-4o-mini
# запасная модель, если основная не ответила (пусто — без запасной)
LLM_FALLBACK_MODEL=
LLM_EMBED_MODEL=text-embedding-3-small

# --- yandex: Yandex Cloud AI Studio (OpenAI-совместимый API) ---
# API-ключ сервисного аккаунта с ролью ai.languageModels.user и ID каталога
YANDEX_API_KEY=
YANDEX_FOLDER_ID=
# модель без префикса gpt://<folder>/ — он подставляется сам. Варианты: yandexgpt/latest, yandexgpt-lite/latest, aliceai-llm
YANDEX_MODEL=yandexgpt/latest
YANDEX_FALLBACK_MODEL=yandexgpt-lite/latest
YANDEX_BASE_URL=https://ai.api.cloud.yandex.net/v1

# --- gigachat: через прокси gpt2giga (docker compose --profile gigachat up -d) ---
# авторизационный ключ из личного кабинета GigaChat API (base64 client_id:secret)
GIGACHAT_CREDENTIALS=
# GIGACHAT_API_PERS (физлица) | GIGACHAT_API_B2B | GIGACHAT_API_CORP
GIGACHAT_SCOPE=GIGACHAT_API_PERS
# придумайте любой секрет — им бэкенд авторизуется в прокси
GPT2GIGA_API_KEY=
GIGACHAT_MODEL=GigaChat-2
GIGACHAT_EMBED_MODEL=EmbeddingsGigaR
# локальный запуск бэкенда без Docker; в Docker адрес подставляется сам (http://gpt2giga:8090/v1)
GIGACHAT_BASE_URL=http://localhost:8090/v1

# --- anthropic (опционально): uv sync --group anthropic ---
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-5-5

# ===================== Эмбеддинги и RAG =====================
# auto: fake для LLM_PROVIDER=fake, local для anthropic, иначе эмбеддинги того же провайдера
# local: sentence-transformers на CPU (uv sync --group local-embeddings)
EMBEDDINGS_PROVIDER=auto
LOCAL_EMBED_MODEL=sentence-transformers/paraphrase-multilingual-MiniLM-L12-v2
RAG_TOP_K=4
# минимальное сходство фрагмента с вопросом (0..1); ниже — «не знаю»
RAG_MIN_SCORE=0.2
CHUNK_SIZE=800
CHUNK_OVERLAP=150
# при запуске бэкенда загрузить новые и изменённые документы фонда из data/demo и data/training
RAG_AUTOLOAD=true

# ===================== Данные =====================
CHROMA_DIR=data/chroma
UPLOADS_DIR=data/uploads
DATABASE_URL=sqlite:///data/app.db

# ===================== Telegram =====================
# токен от @BotFather; пусто — бот не запускается, остальное работает
TELEGRAM_BOT_TOKEN=
# прокси до Bot API, если сервер не достаёт до api.telegram.org (сервер в России); пусто — напрямую.
# На проде деплой берёт адрес прокси Yapp сам (deploy/telegram-from-yapp.sh).
TELEGRAM_API_BASE=
# https-адрес Mini App (домен или адрес из make tunnel); пусто — без кнопки Mini App.
# Бэкенд берёт его же для ссылки на видеособеседование в сообщении волонтёру.
WEBAPP_URL=
# true — бэкенд требует валидный initData от Mini App
TELEGRAM_AUTH_REQUIRED=false
BACKEND_URL=http://localhost:8000

# ===================== Вход на сайт =====================
# код фонда для регистрации координатора — пока его не сменили в кабинете («Настройки»).
# Пусто — регистрация координатора закрыта. Задайте свой, длинный и случайный (на проде — секрет репозитория).
COORDINATOR_CODE=
# Служебный ключ бота и скриптов (seed, ingest, smoke): заголовок X-Service-Key, права координатора.
# make setup дописывает его в .env сам; на проде деплой создаёт новый при каждой выкладке.
# SERVICE_KEY=
# false — выключить Swagger (/docs) и схему API (/openapi.json); на проде выключены
API_DOCS=true

# ===================== Письма с кодом подтверждения почты =====================
# Регистрация: форма → 6-значный код на почту → аккаунт. Письма — через Yandex Cloud Postbox:
# статический ключ сервисного аккаунта (роль postbox.sender) и отправитель на подтверждённом домене.
# На проде ключ и адрес подставляет деплой из .env Yapp (deploy/mail-from-yapp.sh).
POSTBOX_KEY_ID=
POSTBOX_SECRET=
MAIL_FROM=
# Без Postbox: true — код печатается в лог бэкенда (удобно локально), false — регистрация сразу, без кода
MAIL_LOG_CODES=true

# ===================== Видеособеседование (WebRTC) =====================
# STUN помогает браузерам соединиться напрямую; TURN пересылает видео, когда напрямую не выходит
# (мобильный интернет, офисные сети). TURN — coturn Yapp на том же сервере: его --static-auth-secret.
# Пусто — только STUN: звонок работает в большинстве домашних сетей.
# На проде TURN_URLS и TURN_SECRET подставляет деплой из .env Yapp (deploy/turn-from-yapp.sh).
STUN_URLS=stun:stun.l.google.com:19302
TURN_URLS=
TURN_SECRET=

# ===================== Сервер / деплой =====================
# домен для HTTPS (профиль prod), DNS A-запись → IP сервера
DOMAIN=
# на сервере поставьте demo — Streamlit будет на https://DOMAIN/demo
STREAMLIT_BASE_PATH=

LOG_LEVEL=INFO
CORS_ORIGINS=*
