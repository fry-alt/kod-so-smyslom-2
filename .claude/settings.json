{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "attribution": {
    "commit": "",
    "pr": "",
    "sessionUrl": false
  },
  "includeCoAuthoredBy": false,
  "permissions": {
    "allow": [
      "Bash(make test)",
      "Bash(make lint)",
      "Bash(make fmt)",
      "Bash(make smoke)",
      "Bash(uv run pytest:*)",
      "Bash(uv run ruff:*)",
      "Bash(npm run build)",
      "Bash(npm run typecheck)"
    ],
    "deny": ["Read(./.env)"]
  }
}
